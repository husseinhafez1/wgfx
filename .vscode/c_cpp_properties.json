{
    "configurations": [
        {
            "name": "Linux",
            "compilerPath": "/usr/bin/clang++",
            "intelliSenseMode": "linux-clang-x64",
            "cppStandard": "c++20",
            "compileCommands": "${workspaceFolder}/build-linux/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/src",
                "${workspaceFolder}/deps/glad/include",
                "${workspaceFolder}/deps/glfw/include",
                "${workspaceFolder}/deps/glm",
                "${workspaceFolder}/deps/fastgltf/include",
                "${workspaceFolder}/deps/imgui",
                "${workspaceFolder}/deps/imgui/backends",
                "${workspaceFolder}/deps/stb",
                "${workspaceFolder}/deps/tinyobjloader",
                "${workspaceFolder}/deps/FlyCube/src",
                "${workspaceFolder}/deps/FlyCube/src/FlyCube",
                "${workspaceFolder}/deps/FlyCube/src/Modules/AppBox",
                "${workspaceFolder}/deps/FlyCube/src/Modules/AppLoop",
                "${workspaceFolder}/deps/FlyCube/src/Modules/AppSettings",
                "${workspaceFolder}/deps/FlyCube/src/Modules/RenderUtils",
                "${env:HOME}/.local/wgfx-sysroot/usr/include"
            ],
            "defines": [
                "SHADER_DIR=\"${workspaceFolder}/res/shaders/\"",
                "MODEL_DIR=\"${workspaceFolder}/res/models/\"",
                "CUBEMAP_DIR=\"${workspaceFolder}/res/cubemaps/\""
            ]
        }
    ],
    "version": 4
}
